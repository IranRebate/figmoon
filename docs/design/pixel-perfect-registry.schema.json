{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figmoon.local/schemas/pixel-perfect-registry.schema.json",
  "title": "Figmoon Pixel-Perfect Registry",
  "type": "object",
  "required": ["$schema", "_meta", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_meta": {
      "type": "object",
      "required": [
        "version",
        "statusValues",
        "statusAxes",
        "canonicalDesignFamily",
        "thresholds",
        "measurement",
        "viewports"
      ],
      "additionalProperties": true,
      "properties": {
        "version": { "type": "string" },
        "statusValues": {
          "type": "array",
          "items": { "$ref": "#/$defs/status" },
          "uniqueItems": true
        },
        "statusAxes": {
          "type": "object",
          "required": ["referenceStatusValues", "implementationStatusValues", "parityStatusValues"],
          "additionalProperties": false,
          "properties": {
            "referenceStatusValues": {
              "type": "array",
              "items": { "$ref": "#/$defs/referenceStatus" },
              "uniqueItems": true
            },
            "implementationStatusValues": {
              "type": "array",
              "items": { "$ref": "#/$defs/implementationStatus" },
              "uniqueItems": true
            },
            "parityStatusValues": {
              "type": "array",
              "items": { "$ref": "#/$defs/parityStatus" },
              "uniqueItems": true
            }
          }
        },
        "canonicalDesignFamily": {
          "type": "object",
          "required": ["id", "status", "frozenAt", "decisionOwner", "decisionRequired", "rule"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "status": { "enum": ["interim-frozen", "approved"] },
            "frozenAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "decisionOwner": { "type": "string", "minLength": 1 },
            "decisionRequired": { "type": "boolean" },
            "rule": { "type": "string", "minLength": 1 }
          }
        },
        "thresholds": {
          "type": "object",
          "required": [
            "figmaParityPage",
            "figmaParityComponent",
            "structuralEdgeJaccard",
            "regressionBaseline"
          ],
          "additionalProperties": false,
          "properties": {
            "figmaParityPage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "figmaParityComponent": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "structuralEdgeJaccard": { "const": 0 },
            "regressionBaseline": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "measurement": {
          "type": "object",
          "required": ["acceptanceMetric", "rawMetric", "structuralMetric", "rule"],
          "additionalProperties": false,
          "properties": {
            "acceptanceMetric": { "const": "pixelmatch-aa-excluded-v1" },
            "rawMetric": { "const": "pixelmatch-include-aa-v1" },
            "structuralMetric": { "const": "pixelmatch-raw-masked-sobel-jaccard-v3" },
            "rule": { "type": "string", "minLength": 1 }
          }
        },
        "viewports": {
          "type": "object",
          "required": ["desktop", "mobile", "tablet-landscape", "tablet-portrait"],
          "additionalProperties": false,
          "properties": {
            "desktop": { "$ref": "#/$defs/dimensions" },
            "mobile": { "$ref": "#/$defs/dimensions" },
            "tablet-landscape": { "$ref": "#/$defs/dimensions" },
            "tablet-portrait": { "$ref": "#/$defs/dimensions" }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "status": {
      "enum": ["unmapped", "mapped", "in_progress", "figma_parity", "regression_locked", "waived"]
    },
    "referenceStatus": {
      "enum": ["missing", "mapped", "requires-remap", "waived"]
    },
    "implementationStatus": {
      "enum": ["missing", "partial", "implemented", "not-applicable"]
    },
    "parityStatus": {
      "enum": ["not-comparable", "drifting", "in-progress", "parity", "locked", "waived"]
    },
    "kind": {
      "enum": ["page", "component", "overlay", "foundation"]
    },
    "viewport": {
      "enum": ["desktop", "mobile", "tablet-landscape", "tablet-portrait"]
    },
    "theme": {
      "enum": ["light", "dark", "system"]
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "evidencePointer": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/design/evidence/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.json$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["reason", "approvedBy", "approvedAt", "scope"],
      "additionalProperties": true,
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 },
        "approvedAt": { "type": "string", "minLength": 1 },
        "scope": {
          "enum": [
            "full-item",
            "crop",
            "intentional-product-deviation",
            "figma-source-error",
            "not-product-surface"
          ]
        },
        "expiresAt": { "type": "string" }
      }
    },
    "signoff": {
      "type": "object",
      "required": [
        "schemaVersion",
        "runId",
        "evidenceSha256",
        "receipt",
        "approvedBy",
        "leaseOwner",
        "approvedAt",
        "reason",
        "auditCommand",
        "targetSourceFingerprint",
        "rendererFingerprint",
        "referenceSha256",
        "referenceAcquisitionReceiptSha256",
        "baselinePromotionReceiptSha256",
        "snapshotSha256",
        "captureSha256",
        "rawDiffPixelRatio",
        "acceptanceDiffPixelRatio",
        "acceptanceMetric",
        "baselineReproducibilityRatio",
        "maxDiffPixelRatio"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "runId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
        },
        "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "receipt": { "$ref": "#/$defs/evidencePointer" },
        "approvedBy": { "type": "string", "minLength": 2 },
        "leaseOwner": { "type": "string", "minLength": 1 },
        "approvedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        },
        "reason": { "type": "string", "minLength": 12 },
        "auditCommand": { "type": "string", "minLength": 1 },
        "targetSourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rendererFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "referenceAcquisitionReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "baselinePromotionReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "snapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "captureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rawDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "acceptanceDiffPixelRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "acceptanceMetric": { "const": "pixelmatch-aa-excluded-v1" },
        "baselineReproducibilityRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "maxDiffPixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "regressionLockedBy": { "type": "string" },
        "regressionLockedAt": { "type": "string" }
      }
    },
    "designDecision": {
      "type": "object",
      "required": ["status", "owner", "reason", "reviewBy"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["accepted", "open", "waived"] },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "reviewBy": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "baselineUpdate": {
      "type": "object",
      "required": [
        "schemaVersion",
        "measurementRunId",
        "evidenceSha256",
        "receipt",
        "approvedBy",
        "leaseOwner",
        "approvedAt",
        "reason",
        "measurementCommand",
        "targetSourceFingerprint",
        "rendererFingerprint",
        "referenceSha256",
        "referenceAcquisitionReceiptSha256",
        "captureSha256",
        "beforeSha256",
        "afterSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": 1 },
        "approvedBy": { "type": "string", "minLength": 2 },
        "leaseOwner": { "type": "string", "minLength": 1 },
        "approvedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
        },
        "reason": { "type": "string", "minLength": 12 },
        "measurementRunId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$"
        },
        "evidenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "receipt": { "$ref": "#/$defs/evidencePointer" },
        "targetSourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "rendererFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "referenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "referenceAcquisitionReceiptSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "captureSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "measurementCommand": { "type": "string", "minLength": 1 },
        "beforeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "afterSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "legacyBaselineRecord": {
      "type": "object",
      "description": "Non-authoritative historical note retained from the pre-receipt workflow.",
      "additionalProperties": true
    },
    "crop": {
      "type": "object",
      "required": ["id", "title", "x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "maxDiffPixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "waiver": { "$ref": "#/$defs/waiver" }
      }
    },
    "item": {
      "type": "object",
      "required": [
        "id",
        "title",
        "kind",
        "status",
        "referenceStatus",
        "implementationStatus",
        "parityStatus",
        "designDecision",
        "notes"
      ],
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": ["referenceStatus", "implementationStatus"],
            "properties": {
              "referenceStatus": { "const": "mapped" },
              "implementationStatus": { "enum": ["partial", "implemented"] }
            }
          },
          "then": {
            "required": ["visualTest", "snapshot"]
          }
        }
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/kind" },
        "referencePath": { "type": ["string", "null"] },
        "route": { "type": ["string", "null"] },
        "viewport": { "$ref": "#/$defs/viewport" },
        "captureViewport": {
          "allOf": [{ "$ref": "#/$defs/dimensions" }],
          "description": "Exact browser viewport for this visual capture when it differs from the named viewport family. It must describe the whole reference frame, never a crop."
        },
        "theme": { "$ref": "#/$defs/theme" },
        "mockScenario": { "type": ["string", "null"] },
        "status": { "$ref": "#/$defs/status" },
        "referenceStatus": { "$ref": "#/$defs/referenceStatus" },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "parityStatus": { "$ref": "#/$defs/parityStatus" },
        "designDecision": { "$ref": "#/$defs/designDecision" },
        "baselineUpdate": { "$ref": "#/$defs/baselineUpdate" },
        "legacyBaselineRecord": { "$ref": "#/$defs/legacyBaselineRecord" },
        "owner": { "type": ["string", "null"] },
        "notes": { "type": "string" },
        "implementationPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "visualTest": {
          "type": "object",
          "required": ["file", "name"],
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "maxDiffPixelRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "snapshot": { "type": "string" },
        "crops": {
          "type": "array",
          "items": { "$ref": "#/$defs/crop" }
        },
        "waiver": { "$ref": "#/$defs/waiver" },
        "signoff": { "$ref": "#/$defs/signoff" }
      }
    }
  }
}
